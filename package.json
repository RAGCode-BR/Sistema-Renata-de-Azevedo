{
  "name": "sistema-renata-de-azevedo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts",
    "typecheck": "tsc && tsc -p web",
    "db:push": "supabase db push --linked",
    "db:types": "supabase gen types typescript --linked --schema public > shared/database.types.ts",
    "functions:deploy": "supabase functions deploy --use-api",
    "test:db": "supabase db query --linked -f supabase/tests/permissions.sql && supabase db query --linked -f supabase/tests/seguranca.sql && supabase db query --linked -f supabase/tests/financeiro.sql",
    "deploy": "npm run typecheck && npm run build && wrangler deploy",
    "test:e2e": "cd tests && node run.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "supabase": "^2.121.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.0"
  }
}
