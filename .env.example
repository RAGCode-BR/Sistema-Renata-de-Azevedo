# Desenvolvimento local (npm run db:start). Estes são os valores padrão.
PGDATABASE=renata_dev
PGHOST=/tmp
PORT=8787

# Banco externo, como o Supabase (use a string "Session pooler" do painel).
# Com DATABASE_URL definida, o servidor ignora o banco local.
# DATABASE_URL=postgresql://clinica_app.SEU_PROJETO:SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres
# Certificado SSL do provedor (Supabase: Database Settings → SSL Configuration → Download certificate).
# DATABASE_CA_CERT=.data/supabase-ca.crt
