# Cabeçalhos das telas na Cloudflare.
# connect-src libera apenas o projeto Supabase (login, dados e Edge Functions).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self' https://qnchebjrgnfgszrzlyue.supabase.co; form-action 'self'; base-uri 'none'; frame-ancestors 'none'

# Os nomes gerados pelo Vite mudam a cada versão, então podem ficar em cache.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
