{
  "expo": {
    "name": "Renata de Azevedo, Equipe",
    "slug": "renata-equipe",
    "scheme": "renataequipe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.renatadeazevedo.equipe",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "br.com.renatadeazevedo.equipe",
      "adaptiveIcon": {
        "backgroundColor": "#53102F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Usamos o Face ID para desbloquear o aplicativo da clínica."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usamos o Face ID para desbloquear o aplicativo da clínica."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#53102F"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#F5EFE7",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#1D1619"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": ""
      },
      "privacyUrl": "https://sistema-renata-de-azevedo.ragcodebr.workers.dev/privacidade.html"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
